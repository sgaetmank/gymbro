// Prisma: herramienta que te deja describir las tablas y consultarlas desde TypeScript, sin escribir SQL a mano
// traduce entre objetos del lenguaje y filas de tablas.

// prisma generate	--> Lee schema.prisma y genera el cliente tipado (dentro de node_modules)
// prisma db push -->	Compara el esquema con la base y la deja igual (crea o modifica tablas)

// le dice a Prisma que genere el cliente de JavaScript/TypeScript (con tipos exactos para tus tablas).

generator client {
  provider = "prisma-client-js"
}

// qué base se usa (sqlite) y dónde está env("DATABASE_URL")

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 2 roles posibles: Alumno/Entrenador

enum Role {
  ALUMNO
  ENTRENADOR
}

model User {
  id                Int          @id @default(autoincrement())
  role              Role         @default(ALUMNO)
  email             String       @unique
  dni               String       @unique
  passwordHash      String
  firstName         String
  lastName          String
  gender            String
  age               Int
  weight            Float
  height            Float
  phone             String
  emergencyPhone    String
  healthInsurance   String       @default("-")
  contraindications String       @default("Ninguna")
  goal              String
  routineId         Int?         @unique
  routine           Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  workoutLogs       WorkoutLog[]
  gymVisits         GymVisit[]
  createdAt         DateTime     @default(now())
}

model Routine {
  id   Int    @id @default(autoincrement())
  name String @default("Mi Rutina")
  days Day[]
  user User?
}

model Day {
  id        Int     @id @default(autoincrement())
  routineId Int
  name      String
  position  Int
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  blocks    Block[]

  @@index([routineId]) // un índice que acelera "dame los días de esta rutina"
}

model Block {
  id       Int    @id @default(autoincrement())
  dayId    Int
  position Int
  day      Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items    Item[]

  @@index([dayId]) // un índice que acelera "dame los bloques de esta dia"
}

// Un ítem es un ejercicio o un descanso. type decide qué columnas se usan:
//   "exercise": exerciseId, series, repetitions, weightKg, comments
//   "rest":     restTime, restUnit
model Item {
  id          Int     @id @default(autoincrement())
  blockId     Int
  position    Int
  type        String
  exerciseId  String?
  series      Int?
  repetitions Int?
  weightKg    Float?
  comments    String  @default("")
  restTime    Float?
  restUnit    String?
  block       Block   @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId]) // un índice que acelera "dame los items de esta bloque"
}

model WorkoutLog {
  id        Int                  @id @default(autoincrement())
  userId    Int
  date      String
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade) // al borrar un usuario se borran sus registros.
  exercises WorkoutLogExercise[]

  @@index([userId, date]) //  índice compuesto para la consulta típica: "los registros de este usuario en este mes"
}

// Copia (snapshot) de cada ejercicio hecho ese día, con su grupo muscular.
model GymVisit {
  id        Int       @id @default(autoincrement())
  userId    Int
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exitedAt])
  @@index([enteredAt])
}

model WorkoutLogExercise {
  id          Int        @id @default(autoincrement())
  logId       Int
  exerciseId  String
  muscleGroup String
  log         WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade) // al borrar un registro se borran los ejercicios del mismo

  @@index([logId])
}
